import java.util.Scanner;
public class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int org = n;
        int rev=0;
        while(n!=0){
            int d=n%10;
            rev=rev*10+d;
            n/=10;
        }System.out.println(rev);
        if(org==rev){
            System.out.println("palindrom");
        }
        else{
            System.out.print("not palindrom");
        }
    }
}
