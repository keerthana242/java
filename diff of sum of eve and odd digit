import java.util.Scanner;
public class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int esum=0;
        int osum=0;
        while(n!=0){
            int d = n%10;
            n/=10;
            if(d%2==0){
                esum+=d;
            }
            else{
                osum+=d; 
            }
        } System.out.println(esum-osum);
        
}
}
