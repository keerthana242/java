import java.util.Scanner;
public class Main{
    public static void main(String[] args){
       Scanner sc = new Scanner(System.in);
           String str = sc.next();
           String rev = "";
           int le = str.length();
           for( int i=le-1;i>=0;i--){
               rev=rev+str.charAt(i);
           }
           if(rev.equals(str)){
               System.out.println("Palindrom");
           }
           else{
               System.out.println("Not palindrom");
           }
      }
}
