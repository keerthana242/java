import java.util.Scanner;
public class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int pos =1;
        int sum =0;
        while(n!=0){
            int d = n%10;
            if(pos%2 != 0){
                sum+=d;
            }
            pos++;
            n/=10;
        } System.out.println(sum);
        
}
}
