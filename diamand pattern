import java.util.Scanner;
public class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        for(int i=0;i<=n;i++){
            
            for(int j=0;j<=n-i;j++){
                    System.out.print(" ");
                  }
                  
            for(int k=0;k<=i;k++){
                     System.out.print("* ");
                 }             
             System.out.println();
         }
         
         for(int k=1;k<=n;k++){
             
             for(int l=0;l<=k;l++){
                 System.out.print(" ");
             }
             
             for(int m=0;m<=n-k;m++){
                 System.out.print("* ");
             }
             System.out.println();
         }
     }
}
   

        

