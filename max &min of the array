import java.util.Scanner;
public class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[] arr= new int[n];
        int max =0;
        int min = arr[0];
        
        for(int i=0;i<n;i++){
            arr[i]=sc.nextInt();
        }
        
        for(int i=0;i<n;i++){
            if(arr[i]>max){
                max=arr[i];
            }
            else if (arr[i]<min){
                min=arr[i];
            } 
        }
         int[] res={min,max};
        for(int i=0;i<res.length;i++){
           System.out.print(res[i]+" ");
        }
        
    }
}
