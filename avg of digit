import java.util.Scanner;
public class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int le = String.valueOf(n).length();
        int sum=0;
        int avg =0;
        while(n!=0){
            int d = n%10;
            n/=10;
            sum+=d;
            avg = sum/le;
            
        } System.out.println(avg);
        
}
}
